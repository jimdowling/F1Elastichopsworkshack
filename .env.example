# PITLANE 2.2 — SERVER ONLY. Never commit or share a populated .env.
# Easiest setup: python scripts/connect_cloud.py init
# That command creates a private .env with a random operator token.
# Restart the server after first configuration. OS environment overrides this file.

# Safe defaults: no provider calls or cloud writes just by opening the local app.
PITLANE_DATA_MODE=local
PITLANE_FEATURE_MODE=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for connection controls AND access to cloud-mode dashboard data.
PITLANE_ADMIN_TOKEN=

# READ-ONLY event source, not a publishing destination. No Kibana /app URL.
# Use the encoded ApiKey value, without an 'ApiKey ' prefix.
ELASTIC_SOURCE_URL=
ELASTIC_SOURCE_API_KEY=
# Optional private/self-managed CA. TLS verification is NEVER disabled.
ELASTIC_CA_CERT=
ELASTIC_INDEX_SESSIONS=f1-sessions
ELASTIC_INDEX_RESULTS=f1-results
ELASTIC_INDEX_LAPS=f1-laps
ELASTIC_INDEX_WEATHER=f1-weather
ELASTIC_INDEX_TELEMETRY=f1-telemetry

# Alternative organizer variable names are accepted when canonical SOURCE vars
# are REMOVED (empty canonical values intentionally do not fall back):
# CLUSTER=remote
# REMOTE_ELASTICSEARCH_URL=
# REMOTE_ELASTICSEARCH_API_KEY=
# With CLUSTER unset/local, legacy ELASTICSEARCH_URL/API_KEY can be read as source.

# Your Hopsworks project. HOST is a hostname (no https:// or path).
HOPSWORKS_HOST=
HOPSWORKS_PROJECT=
HOPSWORKS_API_KEY=
# Optional private CA; hostname verification stays enabled.
HOPSWORKS_CA_CERT=
# Replace this placeholder with a unique team prefix before publishing.
PITLANE_FEATURE_PREFIX=pitlane_yourteam
PITLANE_FEATURE_VERSION=1
# Even true requires explicit UI name confirmation or CLI --write.
PITLANE_ALLOW_FEATURE_WRITES=false

# Bounds: no 57-million-row download. Telemetry always requires one driver/lap.
PITLANE_REQUEST_TIMEOUT=20
PITLANE_PAGE_SIZE=500
PITLANE_METADATA_LIMIT=5000
PITLANE_LAP_LIMIT=5000
PITLANE_WEATHER_LIMIT=2000
PITLANE_TELEMETRY_LIMIT=20000
PITLANE_CACHE_SECONDS=300

# Legacy original-lab publisher ONLY: your OWN writable destination.
# Do not place the organizer read-only source in these variables when using
# scripts/publish_cloud.py --target elastic --write.
# ELASTICSEARCH_URL=
# ELASTICSEARCH_API_KEY=
