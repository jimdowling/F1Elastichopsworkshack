# PITLANE 2.2 — SERVER ONLY. Never commit or share a populated .env.
# Easiest setup: python scripts/connect_cloud.py init
# That command creates a private .env with a random operator token.
# Restart the server after first configuration. OS environment overrides this file.

# Safe defaults: no provider calls or cloud writes just by opening the local app.
# PITLANE_DATA_MODE: local | hopsworks   PITLANE_FEATURE_MODE: local | hopsworks
PITLANE_DATA_MODE=local
PITLANE_FEATURE_MODE=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for connection controls AND access to cloud-mode dashboard data.
PITLANE_ADMIN_TOKEN=

# Your Hopsworks project. HOST is a hostname (no https:// or path).
HOPSWORKS_HOST=
HOPSWORKS_PROJECT=
HOPSWORKS_API_KEY=
# Optional private CA; hostname verification stays enabled.
HOPSWORKS_CA_CERT=

# READ-ONLY event source tables (feature groups) in the project above.
# Names are lowercase feature-group names; the app never writes to them
# except through the explicit `connect_cloud.py load-source --write` command.
HOPSWORKS_FG_SESSIONS=f1_sessions
HOPSWORKS_FG_RESULTS=f1_results
HOPSWORKS_FG_LAPS=f1_laps
HOPSWORKS_FG_WEATHER=f1_weather
HOPSWORKS_FG_TELEMETRY=f1_telemetry
HOPSWORKS_FG_VERSION=1

# Pace feature group written by the dashboard: <prefix>_race_pace.
# Replace this placeholder with a unique team prefix before publishing.
PITLANE_FEATURE_PREFIX=pitlane_yourteam
PITLANE_FEATURE_VERSION=1
# Even true requires explicit UI name confirmation or CLI --write.
PITLANE_ALLOW_FEATURE_WRITES=false

# Bounds: no whole-corpus download. Telemetry always requires one driver/lap.
PITLANE_REQUEST_TIMEOUT=20
PITLANE_METADATA_LIMIT=5000
PITLANE_LAP_LIMIT=5000
PITLANE_WEATHER_LIMIT=2000
PITLANE_TELEMETRY_LIMIT=20000
PITLANE_CACHE_SECONDS=300
